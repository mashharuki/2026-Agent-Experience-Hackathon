        <mxCell id="ops-title" value="Operations and cost" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
