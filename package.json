{
  "name": "photo-prep-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "A pre-photo grooming assistant built with Bedrock and Strands Decider",
  "scripts": {
    "format": "pnpm exec biome format --write .",
    "check": "pnpm exec biome check --write .",
    "knip": "knip",
    "jscpd": "jscpd --config .jscpd.json apps packages",
    "check:quality": "pnpm run knip && pnpm run jscpd",
    "build:lambda": "uv run --project apps/api python apps/api/scripts/build_lambda.py"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@types/node": "^26.6.5",
    "jscpd": "^5.4.1",
    "knip": "^6.41.0",
    "typescript": "^7.0.2"
  }
}
