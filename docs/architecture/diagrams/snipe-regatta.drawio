        <mxCell id="title" value="One decision: snapshot → options → choice → checks → steering" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="18" width="1640" height="48" />
        </mxCell>
        <mxCell id="subtitle" value="Every 8 simulated seconds per boat · one request in flight · at most 96 per race · the race keeps moving while the model thinks" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;fontStyle=0;fontColor=#4F6B82;" vertex="1" parent="1">
