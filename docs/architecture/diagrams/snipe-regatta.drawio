        <mxCell id="discard" value="" style="fontFamily=Helvetica;fontColor=#163047;rounded=1;arcSize=6;fillColor=#FDF3F2;strokeColor=#D9A39C;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="430" width="530" height="270" />
        </mxCell>
        <mxCell id="discard-title" value="Never applied" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="58" y="438" width="494" height="34" />
        </mxCell>
        <mxCell id="discard-text" value="Replies that arrive late, belong to a paused, ended or restarted race, or no longer fit the boat's leg are logged and change nothing.&#10;&#10;Two failures in a row end the race as &quot;no result&quot;; rules never stand in for the model silently.&#10;&#10;The rule-based preview never calls the model and is labelled as rules." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="62" y="480" width="490" height="210" />
        </mxCell>
        <mxCell id="replay" value="" style="fontFamily=Helvetica;fontColor=#163047;rounded=1;arcSize=6;fillColor=#F2F7FB;strokeColor=#A9BECF;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="595" y="430" width="530" height="270" />
        </mxCell>
        <mxCell id="replay-title" value="Recorded and replayable" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="613" y="438" width="494" height="34" />
        </mxCell>
        <mxCell id="replay-text" value="Each decision records the boat, option, source (decider, preview, fallback), observed and applied ticks, status and latency.&#10;&#10;A saved race stores the physics and wind versions and the applied decisions; replaying it reproduces the race without calling any model." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="617" y="480" width="490" height="210" />
        </mxCell>
        <mxCell id="debrief" value="" style="fontFamily=Helvetica;fontColor=#163047;rounded=1;arcSize=6;fillColor=#F2FBF7;strokeColor=#8CC6B8;strokeWidth=2;dashed=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1150" y="430" width="530" height="270" />
        </mxCell>
        <mxCell id="debrief-title" value="After the finish: Bedrock debrief" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1168" y="438" width="494" height="34" />
        </mxCell>
        <mxCell id="debrief-text" value="One request with a strict summary: finish times, outcome, prediction and the decision log as enums and ticks. No free text.&#10;&#10;Nova Lite cites decisions as [D1], [D2]…; references to decisions that do not exist are removed. Daily quota, 800 tokens, no retry. Preview-only races are not sent." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1172" y="480" width="490" height="210" />
        </mxCell>
      </root>
    </mxGraphModel>
