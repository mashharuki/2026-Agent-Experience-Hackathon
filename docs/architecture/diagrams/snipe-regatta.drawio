        </mxCell>
        <mxCell id="subtitle" value="Deployed and verified 2026-10-23 · Tokyo ap-northeast-1 (CloudFront is global) · simulation and rendering run in the browser; only tactical choices and the debrief go to AWS" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=16;strokeColor=none;fillColor=none;fontStyle=0;fontColor=#4F6B82;" vertex="1" parent="1">
