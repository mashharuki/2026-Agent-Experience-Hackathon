        </mxCell>
        <mxCell id="steer-body" value="The chosen tactic becomes a target; the steering code shared by all four boats follows it.&#10;Different choices split the tracks." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;fontColor=#3A5670;" vertex="1" parent="steer">
