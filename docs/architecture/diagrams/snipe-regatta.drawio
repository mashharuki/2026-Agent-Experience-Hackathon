        <mxCell id="title" value="Snipe AI Regatta  |  AWS architecture (SnipeRegattaStack)" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=30;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="1">
