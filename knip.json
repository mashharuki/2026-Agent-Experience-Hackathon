{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["uv"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {},
    "apps/frontend": {
      "ignoreIssues": {
        "src/api/generated/**": ["exports", "types"]
      }
    },
    "apps/cdk": {
      "entry": ["bin/cdk.ts", "test/**/*.test.ts"],
      "ignoreDependencies": ["ts-node"]
    },
    "packages/*": {}
  }
}
