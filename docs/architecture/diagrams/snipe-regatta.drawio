        <mxCell id="check-label" value="4  Freshness checks" style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=19;strokeColor=none;fillColor=none;fontStyle=1;" vertex="1" parent="check">
