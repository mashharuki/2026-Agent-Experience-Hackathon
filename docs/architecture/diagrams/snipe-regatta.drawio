        <mxCell id="narrow-body" value="Only legal options for the leg: tack upwind, jibe or head to finish downwind, approach the mark within 45 m, gusts that are ahead.&#10;Hold course is always offered, so the model always has a real choice." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;fontColor=#3A5670;" vertex="1" parent="narrow">
