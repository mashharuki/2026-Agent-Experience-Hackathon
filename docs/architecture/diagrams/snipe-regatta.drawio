        <mxCell id="snap-body" value="This boat, the other three, the current wind at the boat, gusts visible now, the mark, the current plan and the boat's profile.&#10;No future wind, no seed, no prediction." style="fontFamily=Helvetica;fontColor=#163047;text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;strokeColor=none;fillColor=none;fontStyle=0;fontColor=#3A5670;" vertex="1" parent="snap">
